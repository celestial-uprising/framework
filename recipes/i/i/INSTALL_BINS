#!/usr/bin/env bash
set -oue pipefail

# 1. Ensure zstd is installed in the build environment to decompress
dnf install -y zstd # Use rpm-ostree install -y zstd if on a silverblue/kinoite base without dnf

# 2. Target directory for your uncompressed binaries
TARGET_DIR="/usr/bin"
mkdir -p "$TARGET_DIR"

# 3. Loop through, decompress, and make executable
for file in /tmp/config/bins/*.zst; do
  if [ -f "$file" ]; then
    echo "Decompressing $file..."
    # Decompress directly to the target directory removing the .zst extension
    zstd -d "$file" -c >"$TARGET_DIR/$(basename "${file%.zst}")"
  fi
done

# 4. Set permissions
chmod +x $TARGET_DIR/*
