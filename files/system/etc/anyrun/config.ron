Config(
  // Position and sizing
  x: Position(Fraction(0.5)),
  y: Position(Fraction(0.2)),
  width: Fraction(0.3),
  height: Absolute(0),

  // Behavior settings
  hide_icons: false,
  ignore_exclusive_zones: false,
  layer: Overlay,
  hide_plugin_info: false,
  close_on_click: true,
  show_results_immediately: false,
  max_entries: None,

  // List of active plugins pointing to your system installation directory
  plugins: [
    "/etc/anyrun/plugins/libapplications.so",
    "/etc/anyrun/plugins/libsymbols.so",
    "/etc/anyrun/plugins/librshell.so",
    "/etc/anyrun/plugins/libtranslate.so",
    "/etc/anyrun/plugins/libwebsearch.so",
    "/etc/anyrun/plugins/libstdin.so",
    "/etc/anyrun/plugins/libkidex.so",
  ],
)
